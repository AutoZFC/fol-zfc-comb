# comb_checker — runs ND→iota_elim→nd_internalize→NDtoLKR on every
# theorem in a .fol.proof file, verifies the resulting LKR program, and
# reports per-theorem pipeline status. The direct LKR→comb path is
# retired (future route: LKR→KS1→comb); this tool ends at LKR verify.
# Used for ZFC end-to-end coverage measurement.
cc_binary(
    name = "comb_checker",
    srcs = ["comb_checker.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/library",
        "//src/parser",
        "//src/proof:proof_value",
        "//src/proof/comb:verifier",
        "//src/proof/lkr:verifier",
        "//src/proof/nd:lowering",
        "//src/proof/translate:theorem_facts",
        "//src/proof/translate/iota_elim:eliminate_iota",
        "//src/proof/translate/ks1_to_comb:read_skew",
        "//src/proof/translate/lkr_cut_elim:b0",
        "//src/proof/translate/lkr_cut_elim:deriv",
        "//src/proof/translate/lkr_cut_elim:reduce",
        "//src/proof/translate/lkr_to_ks1",
        "//src/proof/translate/nd_internalize:apply",
        "//src/proof/translate/nd_to_lkr",
        "//src/runtime",
    ],
)
