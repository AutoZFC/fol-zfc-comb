load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "ops",
    hdrs = ["ops.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/parser",
        "//src/proof:ir",
    ],
)

# ND-specific proof-stack scaffolding (ScopeDeps, AssumptionScope,
# FixVarScope, ProofStack, ClassicalProofStack). Lived in src/core/proof
# during the pre-multi-system era; moved here so each proof system owns
# its own data structures.
cc_library(
    name = "stack",
    srcs = ["stack.cpp"],
    hdrs = ["stack.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/core:scope_utils",
        "//src/util:error",
        "//src/util:registry",
    ],
)

cc_library(
    name = "verifier",
    srcs = ["verifier.cpp"],
    hdrs = ["verifier.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":ops",
        ":stack",
        "//src/core:formula",
        "//src/parser",
        "//src/proof:ir",
        "//src/proof:proof_value",
        "//src/proof:verifier",
        "//src/util:error",
    ],
)

cc_library(
    name = "lowering",
    srcs = ["lowering.cpp"],
    hdrs = ["lowering.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":ops",
        "//src/parser",
        "//src/proof:ir",
        "//src/proof:proof_value",
        "//src/util:error",
    ],
)
