load("@rules_cc//cc:cc_library.bzl", "cc_library")

# equiv: KS1 equivalence ≡ (HSW 2021 §II eq (2)) via canonicalization.
# Track 2 phase K1. Propositional fragment (assoc + comm of ∧/∨); the
# quantifier-shift equations are a follow-up increment. See equiv.h and
# translate/KS1_TRACK2_DESIGN.md §2/§7.
cc_library(
    name = "equiv",
    srcs = ["equiv.cpp"],
    hdrs = ["equiv.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
    ],
)

# derivation + checker: KS1 derivations (Fig. 6) and their validator.
# Track 2 phase K2. Independent of the comb layer. See derivation.h,
# checker.h, translate/KS1_TRACK2_DESIGN.md §3/§4.
cc_library(
    name = "checker",
    srcs = ["checker.cpp"],
    hdrs = [
        "checker.h",
        "derivation.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":equiv",
        "//src/core:formula",
        "//src/util:error",
    ],
)

# decompose: Thm 17 decomposition-form check + split into (Φ1, A', Φ2).
# Track 2 phase K3. See decompose.h, translate/KS1_TRACK2_DESIGN.md §5.
cc_library(
    name = "decompose",
    srcs = ["decompose.cpp"],
    hdrs = ["decompose.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":checker",
        "//src/core:formula",
        "//src/util:error",
    ],
)
