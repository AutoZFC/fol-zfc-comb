load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Stage 1 (ND→ND citation internalization) — Phase 2: schema macro.
#
# schema_macro replaces every SchemaInst(S, σ) op with Use(SH(φᵢ)) where
# φᵢ is the resolved instance formula, registered as a Sentence in ctx.
# Closed-instance only; open instances (free Fixed) are Phase 3.
cc_library(
    name = "schema_macro",
    srcs = ["schema_macro.cpp"],
    hdrs = ["schema_macro.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof:schema_resolve",
        "//src/proof/nd:ops",
        "//src/proof/translate:pass",
        "//src/util:error",
    ],
)

# Phase 4: emit_prelude. Builds the Assume(H) + and_elim chain that
# opens Stage 1's wrapped proof. Pure construction; no scope tracking.
cc_library(
    name = "prelude",
    srcs = ["prelude.cpp"],
    hdrs = ["prelude.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/nd:ops",
        "//src/util:error",
    ],
)

# Phase 5: emit_body_with_remap. Drops Use(F) ops (aliasing to prelude
# extracts via fact_step_table) and Qed (returning its remapped derived
# step as qed_target). Copies every other ND op with StepRef/TermRef
# args remapped to absolute output positions (prelude_length offset).
cc_library(
    name = "body",
    srcs = ["body.cpp"],
    hdrs = ["body.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/nd:ops",
        "//src/proof/translate:pass",
        "//src/util:error",
    ],
)

# Phase 6: apply — end-to-end Stage 1 orchestrator. Composes
# schema_macro → compute_transitive_facts → emit_prelude →
# emit_body_with_remap → postlude. Output gate runs NDVerifier on the
# wrapped proof before returning.
cc_library(
    name = "apply",
    srcs = ["apply.cpp"],
    hdrs = ["apply.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":body",
        ":prelude",
        ":schema_macro",
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/nd:ops",
        "//src/proof/nd:verifier",
        "//src/proof/translate:theorem_facts",
        "//src/util:error",
    ],
)
