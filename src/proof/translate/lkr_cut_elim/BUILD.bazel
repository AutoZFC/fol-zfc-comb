load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Explicit sequent-carrying derivation IR for LKR (build/emit round-trip)
# plus the structural-invariant validator (STAGE3_RESET_PLAN.md Step 1).
# build() invokes validate() before returning, so every Deriv that leaves
# the framework satisfies the convention.
cc_library(
    name = "deriv",
    srcs = ["deriv.cpp", "validate.cpp"],
    hdrs = ["deriv.h", "validate.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:literal",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

# B0 — additive→multiplicative cut pre-pass (STAGE3_RESET_PLAN.md Step 2).
# Walks the Deriv once, rewriting every additive RCut to (|Γ| RWeakens) +
# (multiplicative RCut). Post-condition: every RCut in output is mult.
cc_library(
    name = "b0",
    srcs = ["b0.cpp"],
    hdrs = ["b0.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":deriv",
        "//src/core:formula",
        "//src/util:error",
    ],
)

# Cut-elimination driver (STAGE3_RESET_PLAN.md Step 3).
# Worklist on (degree, topmost) per CUT_ELIM_DESIGN.md §5.1. Dispatch
# table for §5 cases — currently all stubs (Step 4 fills them in).
cc_library(
    name = "reduce",
    srcs = ["reduce.cpp"],
    hdrs = ["reduce.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":b0",
        ":deriv",
        "//src/core:formula",
        "//src/util:error",
    ],
)

# Cut-elimination engine over Deriv: see STAGE3_RESET_PLAN.md.
# Deleted in the Stage 3 reset; rebuild lands in Steps 1–5 of the plan.
