load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Explicit sequent-carrying derivation IR for LKR (build/emit round-trip)
# plus the structural-invariant validator (STAGE3_RESET_PLAN.md Step 1).
# build() invokes validate() before returning, so every Deriv that leaves
# the framework satisfies the convention.
cc_library(
    name = "deriv",
    srcs = ["deriv.cpp", "validate.cpp"],
    hdrs = ["deriv.h", "validate.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:literal",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

