load("@rules_cc//cc:cc_library.bzl", "cc_library")

# InputGate — I-1 (no iota) + I-2 (no eq_subst/eq_sym) + I-3 (ND-verifies).
cc_library(
    name = "input_gate",
    srcs = ["input_gate.cpp"],
    hdrs = ["input_gate.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/nd:ops",
        "//src/proof/nd:verifier",
        "//src/util:error",
    ],
)

