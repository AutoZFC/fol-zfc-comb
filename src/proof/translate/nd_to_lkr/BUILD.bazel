    hdrs = ["sequent_shadow.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:ir",
    ],
)

# emit_close — dual-decomposition primitive (closes a goal via two
# NNF-dual sequent entries). Pure; generic over rule provenance.
cc_library(
    name = "emit_close",
    srcs = ["emit_close.cpp"],
    hdrs = ["emit_close.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":sequent_shadow",
        "//src/core:formula",
        "//src/proof:ir",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

