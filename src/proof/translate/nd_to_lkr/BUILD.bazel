        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/proof/nd:ops",
        "//src/proof/nd:verifier",
        "//src/util:error",
    ],
)

# demand — Demand variant + RecurseDescriptor shared by Phase 2
