load("@rules_cc//cc:cc_library.bzl", "cc_library")

# InputGate — I-1 (no iota) + I-2 (no eq_sym) + I-3 (ND-verifies).
cc_library(
    name = "input_gate",
    srcs = ["input_gate.cpp"],
    hdrs = ["input_gate.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/nd:ops",
        "//src/proof/nd:verifier",
        "//src/util:error",
    ],
)

# BlockTree — nested decomposition of the flat ND op stream
# (OUTER / FORALL / IMPLIES / NOT / EXISTS_ELIM blocks).
cc_library(
    name = "block_tree",
    srcs = ["block_tree.cpp"],
    hdrs = ["block_tree.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/proof:proof_value",
        "//src/proof/nd:ops",
        "//src/util:error",
    ],
)

# demand — demands, targets and hypothesis ids.
cc_library(
    name = "demand",
    hdrs = ["demand.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:ir",
        "//src/proof/lkr_build",
    ],
)

# SequentShadow — translator-side mirror of the verifier's open goal.
cc_library(
    name = "sequent_shadow",
    srcs = ["sequent_shadow.cpp"],
    hdrs = ["sequent_shadow.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":demand",
        "//src/core:formula",
        "//src/proof:ir",
        "//src/proof/lkr:ops",
        "//src/proof/lkr_build",
        "//src/proof/lkr_build:nnf_shapes",
        "//src/util:error",
    ],
)

# ProofIndex — static facts about the ND program; checks I-4.
cc_library(
    name = "proof_index",
    srcs = ["proof_index.cpp"],
    hdrs = ["proof_index.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":block_tree",
        "//src/core:formula",
        "//src/proof:ir",
        "//src/proof:proof_value",
        "//src/proof/lkr_build:nnf_shapes",
        "//src/proof/nd:ops",
        "//src/proof/nd:verifier",
        "//src/util:error",
    ],
)

# FormulaReader — ⟦s⟧σ, the only reader of trace formulas.
cc_library(
    name = "formula_reader",
    srcs = ["formula_reader.cpp"],
    hdrs = ["formula_reader.h"],
    deps = [
        ":proof_index",
        ":sequent_shadow",
        "//src/core:formula",
        "//src/core:scope_utils",
        "//src/proof/nd:verifier",
        "//src/util:error",
    ],
)

# dispatcher — the translation τ(S, s, T, π) (ELIMINATION_DEMANDS_DESIGN.md §2).
cc_library(
    name = "dispatcher",
    srcs = [
        "dispatcher.cpp",
        "intros.cpp",
        "leaves.cpp",
    ],
    hdrs = ["dispatcher.h"],
    deps = [
        ":demand",
        ":formula_reader",
        ":proof_index",
        ":sequent_shadow",
        "//src/core:formula",
        "//src/proof/lkr:ops",
        "//src/proof/lkr_build",
        "//src/proof/lkr_build:nnf_shapes",
        "//src/proof/nd:ops",
        "//src/util:error",
    ],
)

# OutputGate — runs LKRVerifier on emitted programs. Translator is not
# trusted; soundness rests on this gate.
cc_library(
    name = "output_gate",
    srcs = ["output_gate.cpp"],
    hdrs = ["output_gate.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/proof/lkr:verifier",
        "//src/util:error",
    ],
)

# NDtoLKR and NDtoCompactLKR — top-level Passes.
cc_library(
    name = "nd_to_lkr",
    srcs = ["nd_to_lkr.cpp"],
    hdrs = ["nd_to_lkr.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":dispatcher",
        ":formula_reader",
        ":input_gate",
        ":output_gate",
        ":proof_index",
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/proof/lkr_build",
        "//src/proof/lkr_build:expand",
        "//src/proof/nd:ops",
        "//src/proof/nd:verifier",
        "//src/proof/translate:pass",
        "//src/util:error",
    ],
)
