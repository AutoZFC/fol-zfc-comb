load("@rules_cc//cc:cc_library.bzl", "cc_library")

# InputGate — I-1 (LKR-verifies). Future I-2 (CloseByLemma pairing).
cc_library(
    name = "input_gate",
    srcs = ["input_gate.cpp"],
    hdrs = ["input_gate.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/proof/lkr:verifier",
        "//src/util:error",
    ],
)

# DerivationTree — branching tree reconstructed from a flat LKR op stream.
cc_library(
    name = "tree",
    srcs = ["tree.cpp"],
    hdrs = ["tree.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

# CutAugmentation — pre-pass that builds the §15-augmented goal formula
# and per-cut canonical position metadata.
cc_library(
    name = "cut_augment",
    srcs = ["cut_augment.cpp"],
    hdrs = ["cut_augment.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

# build_target — per-hypothesis target construction. Builds
# G(ψ_1) + … + G(ψ_n) for a sequent of NNF entries plus per-entry vertex
# position vectors. Used by the F2 walk to construct G(H_i) at child
# nodes and G(C) at parent nodes per Hughes §11.1.
cc_library(
    name = "build_target",
    srcs = ["build_target.cpp"],
    hdrs = ["build_target.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof/comb:comb_proof",
        "//src/util:error",
    ],
)

# SequentReplay — non-checking simulation of LKR's open-goals stack.
# Computes the per-op conclusion sequent (the goal entries the op
# operates on) needed by the §11.1 leaf and per-rule operations.
cc_library(
    name = "sequent_replay",
    srcs = ["sequent_replay.cpp"],
    hdrs = ["sequent_replay.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":cut_augment",
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

# LemmaInliner — Strategy A pre-pass: splice lemma LKR programs into
# the outer at CloseByLemma points. Replaces Strategy B's CombProof-
# level composition (which only worked for Cut-free lemmas). See
# LKR_TO_COMB_DESIGN.md §4.12.
cc_library(
    name = "lemma_inliner",
    srcs = ["lemma_inliner.cpp"],
    hdrs = ["lemma_inliner.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

# AlphaRename — pre-pass that aligns Forall eigens (and any free
# fix-vars baked into Cut/Weakening formula handles) with the canonical
# binder vars Fograph allocates for the §15-augmented goal. Required
# whenever the LKR program's eigens diverge from Fograph's pre-order
# allocation; see LKR_TO_COMB_DESIGN.md §7.5 (Option B).
cc_library(
    name = "alpha_rename",
    srcs = ["alpha_rename.cpp"],
    hdrs = ["alpha_rename.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":cut_augment",
        ":sequent_replay",
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/comb:comb_proof",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

# §11.1 walk — recursive translation of DerivationTree → CombProof
# against the §15-augmented goal, per-hypothesis targets (F2).
cc_library(
    name = "walk",
    srcs = ["walk.cpp"],
    hdrs = ["walk.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":build_target",
        ":lemma_inliner",
        ":sequent_replay",
        ":tree",
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/comb:comb_proof",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)

# OutputGate — runs CombVerifier on emitted CombProofs.
cc_library(
    name = "output_gate",
    srcs = ["output_gate.cpp"],
    hdrs = ["output_gate.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/comb:comb_proof",
        "//src/proof/comb:verifier",
        "//src/util:error",
    ],
)

# LKRtoComb — top-level pass. F2 per-hypothesis target architecture
# (LKR_TO_COMB_F2_DESIGN.md).
cc_library(
    name = "lkr_to_comb",
    srcs = ["lkr_to_comb.cpp"],
    hdrs = ["lkr_to_comb.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":alpha_rename",
        ":cut_augment",
        ":input_gate",
        ":lemma_inliner",
        ":output_gate",
        ":sequent_replay",
        ":tree",
        ":walk",
        "//src/core:formula",
        "//src/proof:proof_value",
        "//src/proof/comb:comb_proof",
        "//src/proof/lkr:ops",
        "//src/util:error",
    ],
)
